# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
API_PORT=4000
# Supabase hosted Postgres (Prisma)
DATABASE_URL=postgresql://user:password@host:5432/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres
# Supabase auth: set ONE of these (project settings > API / JWT)
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Local dev file storage (replaced by R2/S3 in production)
STORAGE_DIR=.storage

# --- AI providers (server-side only; never expose these to the browser) ---
# Text: OpenRouter. Only free models are ever called; "openrouter/free" picks a free model.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free
# Images: Cloudflare Workers AI. Set EITHER the Worker pair OR the account pair.
CLOUDFLARE_IMAGE_WORKER_URL=
CLOUDFLARE_IMAGE_WORKER_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Platform caps per organization (organizations can only lower these)
AI_DAILY_TEXT_LIMIT=200
AI_MONTHLY_TEXT_LIMIT=3000
AI_DAILY_IMAGE_LIMIT=30
AI_MONTHLY_IMAGE_LIMIT=300
AI_RATE_PER_MINUTE=20

# Sources: text, PDF/DOCX uploads (max 10 MB) and public URLs. No extra settings needed;
# fact extraction uses the AI providers above (free models only).

# Background publishing: posts scheduled content to connected channels. Set off on extra replicas.
PUBLISH_WORKER=on
PUBLISH_POLL_SECONDS=30

# Encrypts channel logins (e.g. WordPress application passwords) at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: changing or losing it makes saved channel logins unreadable (reconnect the channels).
ENCRYPTION_KEY=
