generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  DESIGNER
  APPROVER
  PUBLISHER
  VIEWER
}

// id equals the Supabase auth user id (JWT "sub").
model User {
  id              String       @id @db.Uuid
  email           String       @unique
  name            String?
  isPlatformAdmin Boolean      @default(false)
  createdAt       DateTime     @default(now())
  memberships     Membership[]
}

model Organization {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  slug            String       @unique
  defaultLanguage String       @default("en")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  invitations     Invitation[]
  brandKits       BrandKit[]
  mediaAssets     MediaAsset[]
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  email          String
  role           Role
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model MediaAsset {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  filename       String
  mimeType       String
  sizeBytes      Int
  storageKey     String       @unique
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mainLogoFor    BrandKit[]   @relation("MainLogo")
  altLogoFor     BrandKit[]   @relation("AltLogo")

  @@index([organizationId])
}

// Immutable-ish versions: each save creates a new version; exactly one is active per organization.
model BrandKit {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  version         Int
  isActive        Boolean      @default(false)
  label           String?
  description     String?
  websiteUrl      String?
  defaultLanguage String       @default("en")
  primaryColor    String       @default("#1877F2")
  secondaryColor  String       @default("#0F172A")
  accentColor     String       @default("#F59E0B")
  headingFont     String       @default("Inter")
  bodyFont        String       @default("Inter")
  imageStyle      String?
  socialUrls      Json         @default("{}")
  mainLogoId      String?      @db.Uuid
  altLogoId       String?      @db.Uuid
  createdById     String       @db.Uuid
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mainLogo        MediaAsset?  @relation("MainLogo", fields: [mainLogoId], references: [id], onDelete: SetNull)
  altLogo         MediaAsset?  @relation("AltLogo", fields: [altLogoId], references: [id], onDelete: SetNull)

  @@unique([organizationId, version])
  @@index([organizationId, isActive])
}
