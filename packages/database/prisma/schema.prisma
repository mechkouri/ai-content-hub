generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  DESIGNER
  APPROVER
  PUBLISHER
  VIEWER
}

// id equals the Supabase auth user id (JWT "sub").
model User {
  id              String       @id @db.Uuid
  email           String       @unique
  name            String?
  isPlatformAdmin Boolean      @default(false)
  createdAt       DateTime     @default(now())
  memberships     Membership[]
}

model Organization {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  slug            String       @unique
  defaultLanguage String       @default("en")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  invitations     Invitation[]
  brandKits       BrandKit[]
  mediaAssets     MediaAsset[]
  aiUsages        AiUsage[]
  aiSetting       AiSetting?
  sources         Source[]
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  email          String
  role           Role
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model MediaAsset {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  filename       String
  mimeType       String
  sizeBytes      Int
  storageKey     String       @unique
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mainLogoFor    BrandKit[]   @relation("MainLogo")
  altLogoFor     BrandKit[]   @relation("AltLogo")

  @@index([organizationId])
}

// Immutable-ish versions: each save creates a new version; exactly one is active per organization.
model BrandKit {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  version         Int
  isActive        Boolean      @default(false)
  label           String?
  description     String?
  websiteUrl      String?
  defaultLanguage String       @default("en")
  primaryColor    String       @default("#1877F2")
  secondaryColor  String       @default("#0F172A")
  accentColor     String       @default("#F59E0B")
  headingFont     String       @default("Inter")
  bodyFont        String       @default("Inter")
  imageStyle      String?
  socialUrls      Json         @default("{}")
  mainLogoId      String?      @db.Uuid
  altLogoId       String?      @db.Uuid
  createdById     String       @db.Uuid
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mainLogo        MediaAsset?  @relation("MainLogo", fields: [mainLogoId], references: [id], onDelete: SetNull)
  altLogo         MediaAsset?  @relation("AltLogo", fields: [altLogoId], references: [id], onDelete: SetNull)

  @@unique([organizationId, version])
  @@index([organizationId, isActive])
}

enum AiKind {
  TEXT
  IMAGE
}

enum AiStatus {
  SUCCESS
  FAILED
}

// One row per provider call. Successful rows count against organization quotas.
model AiUsage {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  userId           String       @db.Uuid
  provider         String
  model            String
  kind             AiKind
  status           AiStatus
  errorKind        String?
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  latencyMs        Int          @default(0)
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, createdAt])
}

// Per-organization AI preferences and limits (null = platform default). Limits can only lower platform caps.
model AiSetting {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @unique @db.Uuid
  textModel           String?
  dailyTextLimit      Int?
  monthlyTextLimit    Int?
  dailyImageLimit     Int?
  monthlyImageLimit   Int?
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum SourceType {
  TEXT
  PDF
  DOCX
  URL
}

enum SourceStatus {
  TEXT_READY
  EXTRACTED
  FAILED
}

// Original material a campaign is built from. The original text is always kept, even if AI extraction fails.
model Source {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  type             SourceType
  status           SourceStatus @default(TEXT_READY)
  title            String
  language         String?
  classification   String?
  summary          String?
  originalText     String
  truncated        Boolean      @default(false)
  url              String?
  fileName         String?
  mimeType         String?
  sizeBytes        Int?
  storageKey       String?
  extractionError  String?
  createdById      String       @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facts            SourceFact[]

  @@index([organizationId, createdAt])
}

// One extracted (or manually added) fact, linked back to the exact quote in the source.
model SourceFact {
  id        String   @id @default(uuid()) @db.Uuid
  sourceId  String   @db.Uuid
  kind      String
  value     String
  quote     String?
  verified  Boolean  @default(false)
  manual    Boolean  @default(false)
  edited    Boolean  @default(false)
  createdAt DateTime @default(now())
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}
