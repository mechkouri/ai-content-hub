generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  DESIGNER
  APPROVER
  PUBLISHER
  VIEWER
}

// id equals the Supabase auth user id (JWT "sub").
model User {
  id              String       @id @db.Uuid
  email           String       @unique
  name            String?
  isPlatformAdmin Boolean      @default(false)
  createdAt       DateTime     @default(now())
  memberships     Membership[]
}

model Organization {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  slug            String         @unique
  defaultLanguage String         @default("en")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  memberships     Membership[]
  invitations     Invitation[]
  brandKits       BrandKit[]
  mediaAssets     MediaAsset[]
  aiUsages        AiUsage[]
  aiSetting       AiSetting?
  sources         Source[]
  contentPieces   ContentPiece[]
  campaigns       Campaign[]
  channels        Channel[]
  publishJobs     PublishJob[]
}

enum ChannelProvider {
  TEST
  WORDPRESS
  FACEBOOK
  INSTAGRAM
  LINKEDIN
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

// A place content can be published to: a social page, a website, or the built-in test channel.
model Channel {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  provider       ChannelProvider
  name           String
  status         ChannelStatus   @default(CONNECTED)
  /// Non-secret settings (site address, page name...). Secrets never live here.
  config         Json            @default("{}")
  lastError      String?
  /// Login for the channel, encrypted with ENCRYPTION_KEY. Never returned by the API.
  credentials    String?
  /// When on, content scheduled in the calendar is queued to this channel automatically.
  autoPublish    Boolean         @default(false)
  createdById    String          @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs           PublishJob[]

  @@index([organizationId, status])
}

enum PublishStatus {
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

// One publication of one piece of content to one channel. The unique pair is what stops double posting.
model PublishJob {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  contentId       String        @db.Uuid
  channelId       String        @db.Uuid
  status          PublishStatus @default(QUEUED)
  runAt           DateTime
  /// True when the job follows the content's scheduled date (moved or cancelled with it).
  followsSchedule Boolean       @default(false)
  attempts        Int           @default(0)
  lastError       String?
  /// What is (or would be) posted, kept for the audit trail and for test channels.
  payload         Json?
  externalId      String?
  externalUrl     String?
  publishedAt     DateTime?
  createdById     String        @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  content         ContentPiece  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  channel         Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([contentId, channelId])
  @@index([status, runAt])
  @@index([organizationId, createdAt])
}

enum CampaignStatus {
  ACTIVE
  ARCHIVED
}

// A named group of content (articles and posts) with optional dates, e.g. "Open Day 2027".
model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String
  description    String?
  startsOn       DateTime?      @db.Date
  endsOn         DateTime?      @db.Date
  status         CampaignStatus @default(ACTIVE)
  createdById    String         @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pieces         ContentPiece[]

  @@index([organizationId, status])
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  email          String
  role           Role
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model MediaAsset {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  filename       String
  mimeType       String
  sizeBytes      Int
  storageKey     String         @unique
  createdById    String         @db.Uuid
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentImages  ContentImage[]
  mainLogoFor    BrandKit[]     @relation("MainLogo")
  altLogoFor     BrandKit[]     @relation("AltLogo")

  @@index([organizationId])
}

// Immutable-ish versions: each save creates a new version; exactly one is active per organization.
model BrandKit {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  version         Int
  isActive        Boolean      @default(false)
  label           String?
  description     String?
  websiteUrl      String?
  defaultLanguage String       @default("en")
  primaryColor    String       @default("#1877F2")
  secondaryColor  String       @default("#0F172A")
  accentColor     String       @default("#F59E0B")
  headingFont     String       @default("Inter")
  bodyFont        String       @default("Inter")
  imageStyle      String?
  socialUrls      Json         @default("{}")
  mainLogoId      String?      @db.Uuid
  altLogoId       String?      @db.Uuid
  createdById     String       @db.Uuid
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mainLogo        MediaAsset?  @relation("MainLogo", fields: [mainLogoId], references: [id], onDelete: SetNull)
  altLogo         MediaAsset?  @relation("AltLogo", fields: [altLogoId], references: [id], onDelete: SetNull)

  @@unique([organizationId, version])
  @@index([organizationId, isActive])
}

enum AiKind {
  TEXT
  IMAGE
}

enum AiStatus {
  SUCCESS
  FAILED
}

// One row per provider call. Successful rows count against organization quotas.
model AiUsage {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  userId           String       @db.Uuid
  provider         String
  model            String
  kind             AiKind
  status           AiStatus
  errorKind        String?
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  latencyMs        Int          @default(0)
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, createdAt])
}

// Per-organization AI preferences and limits (null = platform default). Limits can only lower platform caps.
model AiSetting {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @unique @db.Uuid
  textModel         String?
  dailyTextLimit    Int?
  monthlyTextLimit  Int?
  dailyImageLimit   Int?
  monthlyImageLimit Int?
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum SourceType {
  TEXT
  PDF
  DOCX
  URL
}

enum SourceStatus {
  TEXT_READY
  EXTRACTED
  FAILED
}

// Original material a campaign is built from. The original text is always kept, even if AI extraction fails.
model Source {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  type            SourceType
  status          SourceStatus   @default(TEXT_READY)
  title           String
  language        String?
  classification  String?
  summary         String?
  originalText    String
  truncated       Boolean        @default(false)
  url             String?
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  storageKey      String?
  extractionError String?
  createdById     String         @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facts           SourceFact[]
  contentPieces   ContentPiece[]

  @@index([organizationId, createdAt])
}

// One extracted (or manually added) fact, linked back to the exact quote in the source.
model SourceFact {
  id        String   @id @default(uuid()) @db.Uuid
  sourceId  String   @db.Uuid
  kind      String
  value     String
  quote     String?
  verified  Boolean  @default(false)
  manual    Boolean  @default(false)
  edited    Boolean  @default(false)
  createdAt DateTime @default(now())
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

enum ContentKind {
  ARTICLE
  INSTAGRAM
  FACEBOOK
  LINKEDIN
}

enum ContentStatus {
  DRAFT
  NEEDS_REVIEW
}

// Human approval workflow, separate from the automatic claim check above.
enum ApprovalStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum ReviewAction {
  SUBMITTED
  WITHDRAWN
  APPROVED
  CHANGES_REQUESTED
  INVALIDATED
}

// Append-only history of approval decisions on a piece of content.
model ContentReview {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  contentId      String       @db.Uuid
  action         ReviewAction
  actorId        String       @db.Uuid
  comment        String?
  createdAt      DateTime     @default(now())
  content        ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
}

// A generated piece of content (article or social post), always built from a source's verified facts.
// `content` is validated against a per-kind schema; `warnings` lists claims not supported by the facts.
model ContentPiece {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @db.Uuid
  sourceId         String          @db.Uuid
  kind             ContentKind
  status           ContentStatus   @default(DRAFT)
  approvalStatus   ApprovalStatus  @default(DRAFT)
  submittedById    String?         @db.Uuid
  scheduledFor     DateTime?
  scheduledById    String?         @db.Uuid
  campaignId       String?         @db.Uuid
  campaign         Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  language         String
  title            String
  content          Json
  options          Json            @default("{}")
  warnings         Json            @default("[]")
  usedFactIds      Json            @default("[]")
  translatedFromId String?         @db.Uuid
  edited           Boolean         @default(false)
  model            String?
  provider         String?
  createdById      String          @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source           Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  translatedFrom   ContentPiece?   @relation("Translations", fields: [translatedFromId], references: [id], onDelete: SetNull)
  translations     ContentPiece[]  @relation("Translations")
  reviews          ContentReview[]
  publishJobs      PublishJob[]
  images           ContentImage[]

  @@index([organizationId, sourceId, createdAt])
  @@index([organizationId, approvalStatus])
  @@index([organizationId, scheduledFor])
  @@index([organizationId, campaignId])
}

// An image attached to a piece of content, in display order. Removing the media deletes the attachment.
model ContentImage {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  contentId      String       @db.Uuid
  assetId        String       @db.Uuid
  position       Int
  createdAt      DateTime     @default(now())
  content        ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)
  asset          MediaAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([contentId, assetId])
  @@index([contentId, position])
}
